#!/bin/sh
# commit-msg hook —— 校验提交信息符合 Conventional Commits 规范。
#
# 规则（与 AGENTS.md §8 / CONTRIBUTING.md 一致）：
#   head 必须形如：type(scope): desc
#     type  限 feat|fix|docs|refactor|chore|test|build|ci|perf|style|revert
#     scope 可选（如 feat(bus): ...）
#     desc  非空，中文或英文皆可
#   body 可选：head 后空行，用 "- " 分条
#   footer 可选：body 后空行，token 限 Refs / Closes / Fixes / Resolves /
#     BREAKING CHANGE / Co-authored-by / Signed-off-by / Reviewed-by；
#     "Closes #123" 这类不带冒号的写法也接受。
#   只在出现 footer token 时校验 footer 段，普通正文不会被误伤。
#   放行 merge 提交（--no-ff 合并）与 revert 提交的默认信息。
#
# 校验失败时以非零退出码中止提交，错误信息指向 AGENTS.md。

MSG_FILE="$1"

# 跳过临时/异常提交信息
if [ ! -f "$MSG_FILE" ]; then
    exit 0
fi

FIRST_LINE=$(grep -m1 '' "$MSG_FILE")
# 去掉结尾换行
FIRST_LINE=$(printf '%s' "$FIRST_LINE")

# 放行 merge / revert 自动生成的信息
case "$FIRST_LINE" in
    Merge*|Revert*)
        exit 0
        ;;
esac

# type(scope): desc
if ! printf '%s' "$FIRST_LINE" | grep -Eq '^(feat|fix|docs|refactor|chore|test|build|ci|perf|style|revert)(\([a-z0-9-]+\))?: .+$'; then
    echo ""
    echo "提交信息不符合 Conventional Commits 格式："
    echo "  head 应形如：type(scope): 描述"
    echo "  type 允许：feat fix docs refactor chore test build ci perf style revert"
    echo "  示例：feat: 添加登录功能  或  fix(bus): 修复注册表竞态"
    echo "  规范详见 AGENTS.md「Git 流程」与 CONTRIBUTING.md"
    echo ""
    exit 1
fi

# footer 段校验：仅当最后一段出现已知 footer token 时才检查该段其余行
FOOTER=$(awk 'BEGIN { RS="" } { last = $0 } END { print last }' "$MSG_FILE")
if printf '%s\n' "$FOOTER" | grep -Eq '^(Refs|Closes|Fixes|Resolves|BREAKING CHANGE|Co-authored-by|Signed-off-by|Reviewed-by)(: | #)'; then
    BAD=$(printf '%s\n' "$FOOTER" | grep -Ev '^(Refs|Closes|Fixes|Resolves|BREAKING CHANGE|Co-authored-by|Signed-off-by|Reviewed-by)(: .+| #[0-9]+)$' | grep -v '^$' || true)
    if [ -n "$BAD" ]; then
        echo ""
        echo "footer 段含无法识别的行："
        printf '%s\n' "$BAD" | sed 's/^/  /'
        echo "  footer 每行应形如：Refs: #123 / Closes #123 / BREAKING CHANGE: ..."
        echo "  允许的 token：Refs Closes Fixes Resolves BREAKING CHANGE Co-authored-by Signed-off-by Reviewed-by"
        echo ""
        exit 1
    fi
fi

exit 0
